# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=kiddy_link
MYSQL_USER=kiddy
MYSQL_PASSWORD=kiddypass
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kiddy-link

# API
API_PORT=3000
NODE_ENV=development
PORT=3000

# Database URL (local dev without Docker API container)
DATABASE_URL=mysql://kiddy:kiddypass@localhost:3306/kiddy_link

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Default admin (seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=مديرة الروضة

# MinIO (local dev)
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# OpenAI (Phase 3)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agora (Phase 5)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE=3600

# FCM (Phase 2)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
